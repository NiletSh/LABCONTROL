PORT=4000
# La API solo usa MySQL. En Render, PORT lo asigna Render.
# El puerto de la base va en DB_PORT.
# DB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=usuario.root
# DB_PASSWORD=cambiar_clave
# DB_NAME=lab_control
# En Vercel, la página llama al servidor de Render:
# VITE_API_URL=https://labcontrol-kvpg.onrender.com
# Correo con Gmail. En la cuenta de Google crea una contraseña de aplicación
# y ponla en SMTP_PASS. No uses la contraseña normal de Gmail.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=correo@gmail.com
# SMTP_PASS=contraseña_de_aplicacion
# SMTP_FROM=LAB CONTROL <correo@gmail.com>
